APP_URL=
AURASLIM_ADMIN_PASSWORD=
AURASLIM_DATA_DIR=
DISABLE_HMR=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_CLOUD_TRANSLATE_API_KEY=
PORT=
STRIPE_PRICE_COMPLETE_PACK=
STRIPE_PRICE_PROGRESS_VIDEO=
STRIPE_PRICE_SCAN_MEALS=
STRIPE_SECRET_KEY=

# Keep disabled until a real image generation test succeeds with your server key.
ENABLE_GOAL_PHOTO=false

# Optional public video links, require APP_URL=https://your-domain and a persistent DATA_DIR.
ENABLE_VIDEO_LINKS=true

# Cloud Run: optional private shared bucket for encrypted checkout recovery.
# Without it, AURASLIM_DATA_DIR must be a persistent shared volume.
AURASLIM_BACKUP_BUCKET=
